rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    // Rubrics are files stored one level beneath their event/result folder.
    // Matching only the folder path does not authorize uploads to those files.
    match /results/{event}/{result}/{file=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /files/{event}/{teamId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Any signed-in user can manage files in a team's submission folder.
    match /submissions/{event}/{teamId}/{file} {
      allow read, write: if request.auth != null;
    }
    // Admins may manage every object under the submissions namespace.
    match /submissions/{path=**} {
      allow read, write: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
