rules_version = '2';


service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    match /users/{user} {
      allow read: if request.auth != null;
      // Members may manage their own profile, but authorization fields must
      // never be client-writable. Admin status is the source of truth for
      // privileged Firestore writes and for the server route guard.
      allow create: if
        request.auth != null &&
        user == request.auth.token.email &&
        !('admin' in request.resource.data);
      allow update: if
        request.auth != null &&
        (isAdmin() ||
          (user == request.auth.token.email &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin'])));
      allow delete: if isAdmin();
    }
    match /events/{event} {
      allow read: if request.auth != null;
      allow write: if 
        request.auth != null &&
        isAdmin();
    }
    match /mail/{email} {
      // should only be written through request functions
    	allow read, write: if false;
    }
    match /settings/{setting} {
    	allow read: if request.auth != null;
      allow write: if
        request.auth != null &&
        isAdmin();
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
